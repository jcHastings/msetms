# /etc/msetms/backup.env  (root:root 0600)  -- NAMES ONLY in git.
# Used by msetms-litestream.service and the nightly/restore/heartbeat scripts.
# R2: bucket-scoped API token (Object Read & Write on ONE bucket only).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# age PUBLIC key (age1...). Not secret. The matching private key stays with JC in the secret store.
AGE_RECIPIENT=
# Long random passphrase for the rclone crypt remote holding uploads/. Keep a copy in the secret store.
UPLOADS_CRYPT_PASSWORD=
NIGHTLY_KEEP_DAYS=35
# Healthchecks.io ping URLs (each is a capability URL: treat as a secret).
HC_BACKUP_URL=
HC_RESTORE_URL=
HC_HEARTBEAT_URL=
HC_LITESTREAM_URL=
