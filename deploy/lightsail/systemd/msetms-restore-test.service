[Unit]
Description=MS Express TMS: Weekly Litestream restore drill
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/msetms/backup.env

[Service]
Type=oneshot
ExecStartPre=+/usr/local/sbin/msetms-backup-check
ExecStart=/usr/local/sbin/msetms-restore-test
Nice=10
IOSchedulingClass=idle
