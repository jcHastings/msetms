[Unit]
Description=MS Express TMS: Nightly encrypted offsite snapshot (DB + uploads) to R2
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/msetms/backup.env

[Service]
Type=oneshot
ExecStartPre=+/usr/local/sbin/msetms-backup-check
ExecStart=/usr/local/sbin/msetms-backup-nightly
Nice=10
IOSchedulingClass=idle
