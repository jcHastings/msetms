# Copy this file to .env or .env.local, fill in local values, and restart the app.
# Do not commit .env or .env.local.
# Production / Windows: from this folder run `npm run build` then `npm start`.
# After build, public and .next/static are copied into .next/standalone (no
# symlink) so styles load. Missing those folders = unstyled raw HTML.
# Do not use `next start` — it skips this file (standalone output).
# Mike and Samsara also reload this file at request time from process.cwd()/.env,
# this project-root .env, and .next/standalone/.env (values trimmed, never logged).

# Session signing secret for office and web-driver cookies.
# Generate a long random string (32+ chars). Never commit real values.
SESSION_SECRET=

# Samsara — tractor GPS, HOS, Trucks → Import from Samsara, and load camera stills
# Token scopes for stills: Write Media Retrieval + Read Media Retrieval
# (Safety & Cameras). Never log this token.
SAMSARA_API_TOKEN=

# ORBCOMM — trailer tracking, reefer, and Trailers → Import from Orbcomm
# Ask ORBCOMM for Transportation Platform (B2B) username/password.
# If the API has no asset list yet, upload a CSV/export on Trailers (preview then import).
# Do not scrape the logged-in portal.
ORBCOMM_USERNAME=
ORBCOMM_PASSWORD=
ORBCOMM_ACCOUNT_ID=
ORBCOMM_API_BASE=https://platform.orbcomm.com

# PrePass — Office Tolls API pull. Prefer OAuth client id/secret.
# Leave client id/secret empty to use manual CSV/XLSX import only.
# REST pull needs PREPASS_ACCOUNT_NUMBER (JC: M & S LOADS LLC PP).
# If OAuth or account number is missing, API pull no-ops with a clear banner
# and manual import keeps working.
# Never commit client id/secret. Never log the secret or token.
PREPASS_CLIENT_ID=
PREPASS_CLIENT_SECRET=
PREPASS_ACCOUNT_NUMBER=370972
# Optional overrides. Defaults match the locked developer.prepass.com contract.
# PREPASS_TOKEN_URL=https://api.prepass.com/auth/v1/token
# PREPASS_API_BASE=https://api.prepass.com
# PREPASS_TRANSACTIONS_PATH=/tolltransaction/v1/transactions
# Grant type is not in the portal. Header-only first; client_credentials body is retry only.
# Optional legacy fallback. OAuth replaced the PREPASS_API_KEY stub.
# PREPASS_API_KEY=

# QuickBooks Online — invoice delivered loads (customer rate, not OO pay)
# Settings → QuickBooks → Connect QuickBooks. Do not commit real values.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QBO_SANDBOX=true
# Optional aliases still accepted: QUICKBOOKS_CLIENT_ID / SECRET / REFRESH_TOKEN / REALM_ID / ENVIRONMENT

# Google Maps — Places (Locations / New Load), Directions (load routing), and
# Maps JavaScript API (per-load map). Never commit a real key. Never log the key.
# Enable Places, Geocoding, Directions, and Maps JavaScript API on the key.
# If missing, address fields stay manual, route miles stay empty/manual, and
# the load map hides. Restrict a browser-exposed key by HTTP referrer.
GOOGLE_MAPS_API_KEY=
# Browser-only key for map components rendered in HTML.
# Use a separate key from GOOGLE_MAPS_API_KEY and lock it to trusted referrers.
GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_PLACES_API_KEY=

# Mike and the New Load rate-con reader share this key (not the driver app).
# Only this key is required. Always gpt-4o-mini (cheap). Never commit or log the key.
OPENAI_API_KEY=

# Twilio — dispatcher SMS to the assigned driver's mobile
# Never commit real values. Never log the auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional Twilio WhatsApp From, same account as SMS. Shape: whatsapp:+1XXXXXXXXXX
# Leave unset until the sender is ONLINE. Never commit the value.
# TWILIO_WHATSAPP_FROM=

# Mail — real send from the load (driver trip packet / customer tracking)
# Prefer SMTP. If SMTP_HOST is empty, SENDGRID_API_KEY is used instead.
# Never commit real values. Never log the password or API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=dispatch@msloads.com
SMTP_PASS=
SMTP_FROM=dispatch@msloads.com
# SENDGRID_API_KEY=

# Driver API v1 — trust X-Forwarded-For / X-Real-IP for login rate limits.
# Spoofable unless a reverse proxy overwrites those headers. Cloudflare Tunnel
# staging can leave this unset; CF-Connecting-IP is used when present.
# TRUSTED_PROXY=1
