# Copy this file to .env or .env.local, fill in local values, and restart the app.
# Do not commit .env or .env.local.

# Dispatcher sign-in (required before the board opens)
# First start with no users: creates username "admin" from this password (min 8 chars).
# Leave empty here. Set the real password only in gitignored .env / .env.local.
DISPATCH_PASSWORD=
# Optional. Default is admin.
# DISPATCH_USERNAME=admin
# Set to 1 when the app is served over HTTPS so the session cookie is Secure.
TMS_COOKIE_SECURE=

# Samsara — tractor GPS, driver HOS, IFTA miles. Bearer token only.
# Create at cloud.samsara.com → Settings → API Tokens.
# Scopes: Read Vehicles, Read ELD Compliance Settings (US), Read IFTA (US).
# Trip-window IFTA also needs Write IFTA (US). Never paste this into Slack/chat.
SAMSARA_API_TOKEN=

# ORBCOMM — trailer GPS + reefer (Transportation Platform B2B).
# Official auth is username + password → POST /SynB2BGatewayService/api/generateToken
# (Postman: userName, password, optional orgKey). Ask your ORBCOMM CSM.
# Do not scrape https://platform.orbcomm.com/#/portal/remote/ReeferStatusReport
ORBCOMM_USERNAME=
ORBCOMM_PASSWORD=
ORBCOMM_ORG_KEY=
ORBCOMM_ACCOUNT_ID=
# Optional. Official B2B does not use these; reserved if ORBCOMM issues OAuth keys.
ORBCOMM_CLIENT_ID=
ORBCOMM_CLIENT_SECRET=
ORBCOMM_API_BASE=https://platform.orbcomm.com

# QuickBooks Online — invoice delivered loads (customer rate, not OO pay)
# Complete OAuth outside this app (Intuit OAuth 2.0 Playground) and paste the
# refresh token + realm id. Do not commit real values.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox
