# Copy this file to .env or .env.local, fill in local values, and restart the app.
# Do not commit .env or .env.local.

# Samsara — tractor GPS and driver Hours of Service only
SAMSARA_API_TOKEN=

# ORBCOMM — trailer tracking and reefer status (Reefer Status Report)
# Ask ORBCOMM for Transportation Platform (B2B) username/password.
# Do not scrape the logged-in portal.
ORBCOMM_USERNAME=
ORBCOMM_PASSWORD=
ORBCOMM_ACCOUNT_ID=
ORBCOMM_API_BASE=https://platform.orbcomm.com

# QuickBooks Online — invoice delivered loads (customer rate, not OO pay)
# Complete OAuth outside this app (Intuit OAuth 2.0 Playground) and paste the
# refresh token + realm id. Do not commit real values.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox

# Google Places — address search on Locations and New Load / rate-con
# Server-side Autocomplete + Place Details only. Never commit a real key.
# Never log the key. If missing, address fields stay manual.
# If you must use a browser key, restrict it by HTTP referrer to localhost.
GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Twilio — dispatcher SMS to the assigned driver's mobile
# Never commit real values. Never log the auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
